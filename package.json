{
  "name": "@shcherbin/oxc-config",
  "description": "Shareable Oxlint and Oxfmt configs",
  "version": "0.1.0",
  "author": "Vlad Shcherbin <vlad.shcherbin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladshcherbin/oxc-config.git"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepublishOnly": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "confusing-browser-globals": "^1.0.11",
    "eslint-plugin-perfectionist": "^5.10.1"
  },
  "peerDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@shcherbin/typescript-config": "^1.0.0",
    "@types/confusing-browser-globals": "^1.0.3",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "oxlint",
    "oxfmt",
    "oxc",
    "config",
    "linter",
    "formatter",
    "node",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">= 26"
  },
  "sideEffects": false,
  "type": "module",
  "license": "MIT"
}

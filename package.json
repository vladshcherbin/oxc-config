{
  "name": "@shcherbin/oxc-config",
  "description": "Shareable Oxlint and Oxfmt configs",
  "version": "0.0.0",
  "author": "Vlad Shcherbin <vlad.shcherbin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vladshcherbin/oxc-config.git"
  },
  "exports": {
    "./config": "./dist/config.mjs",
    "./format": "./dist/format.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt --check",
    "lint": "oxlint",
    "prepublishOnly": "pnpm format && pnpm lint && pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@shcherbin/typescript-config": "^1.0.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 26"
  },
  "sideEffects": false,
  "type": "module",
  "license": "MIT"
}
